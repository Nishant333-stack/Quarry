# --- Postgres (Cloud SQL in prod, docker-compose locally) ---
QUARRY_DATABASE_URL=postgresql://quarry_app:quarry_app@localhost:5432/quarry
QUARRY_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quarry

# --- Model provider: "gemini" or "offline" (no network, retrieval-only) ---
QUARRY_PROVIDER=gemini
QUARRY_CHAT_MODEL=gemini-3.8-flash
QUARRY_EMBED_MODEL=gemini-embedding-001
QUARRY_EMBED_DIM=768

# Gemini Developer API key, OR Vertex AI (set the three GOOGLE_* vars instead)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# --- API auth: comma-separated tenant:sha256(api_key) pairs ---
# python -c "import hashlib;print(hashlib.sha256(b'my-key').hexdigest())"
QUARRY_API_KEYS=
QUARRY_RATE_LIMIT_RPM=120
